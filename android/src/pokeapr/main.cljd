(ns pokeapr.main
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/foundation.dart" :as foundation]
            ["package:firebase_core/firebase_core.dart" :as fb]
            ["package:cloud_firestore/cloud_firestore.dart" :as fs]
            [cljd.flutter :as f]))

;; Credentials are injected at build time via --dart-define.
;; For release builds supply real values:
;;   flutter run --dart-define=FIREBASE_API_KEY=AIza... --dart-define=FIREBASE_APP_ID=1:...
;; The defaults work against the local Firestore emulator (debug only).
(def firebase-options
  (fb/FirebaseOptions
   .apiKey (String/fromEnvironment "FIREBASE_API_KEY" .defaultValue "fake-api-key-for-emulator")
   .appId (String/fromEnvironment "FIREBASE_APP_ID" .defaultValue "1:123456789:android:000000000000abcd")
   .messagingSenderId (String/fromEnvironment "FIREBASE_MESSAGING_SENDER_ID" .defaultValue "123456789")
   .projectId (String/fromEnvironment "FIREBASE_PROJECT_ID" .defaultValue "pokeapr-dev")
   .storageBucket (String/fromEnvironment "FIREBASE_STORAGE_BUCKET" .defaultValue "pokeapr-dev.appspot.com")))

;; Android emulator reaches the host machine via 10.0.2.2;
;; Web browsers running on the same machine use localhost.
(def emulator-host (if foundation/kIsWeb "localhost" "10.0.2.2"))
(def emulator-port 8080)

(defn action-colors [action]
  (case action
    "opened"   {:bg 0xFFE8F5E9 :fg 0xFF2E7D32}
    "closed"   {:bg 0xFFFFEBEE :fg 0xFFC62828}
    "reopened" {:bg 0xFFE3F2FD :fg 0xFF1565C0}
    {:bg 0xFFE8EAF6 :fg 0xFF3949AB}))

(defn event-card [doc]
  ;; .data returns a native Dart Map<String,dynamic>; convert to a ClojureDart
  ;; map so that `get` resolves keys correctly.
  (let [data    (into {} (or (.data doc) {}))
        action  (get data "action")
        colors  (action-colors (or action ""))]
    (m/Card
     .margin (m/EdgeInsets.symmetric .horizontal 12.0 .vertical 6.0)
     .elevation 3.0
     .child (m/Padding
             .padding (m/EdgeInsets.all 16.0)
             .child (m/Column
                     .crossAxisAlignment m/CrossAxisAlignment.start
                     .mainAxisSize m/MainAxisSize.min
                     .children
                     (filterv some?
                      [(m/Row
                        .mainAxisAlignment m/MainAxisAlignment.spaceBetween
                        .children
                        (filterv some?
                         [(m/Container
                           .padding (m/EdgeInsets.symmetric .horizontal 8.0 .vertical 4.0)
                           .decoration (m/BoxDecoration
                                        .color (m/Color (:bg colors))
                                        .borderRadius (m/BorderRadius.circular 4.0))
                           .child (m/Text (str (get data "event_type" "unknown"))
                                          .style (m/TextStyle
                                                  .fontSize 12.0
                                                  .color (m/Color (:fg colors))
                                                  .fontWeight m/FontWeight.w600)))
                          (when action
                            (m/Text action
                                    .style (m/TextStyle
                                            .color (m/Color (:fg colors))
                                            .fontWeight m/FontWeight.w500)))]))
                       (m/SizedBox .height 8.0)
                       (when-let [title (get data "title")]
                         (m/Text title
                                 .style (m/TextStyle .fontWeight m/FontWeight.bold
                                                     .fontSize 16.0)))
                       (when-let [repo (get data "repo")]
                         (m/Text (str "Repo: " repo)
                                 .style (m/TextStyle .color m/Colors.grey)))
                       (when-let [author (get data "author")]
                         (m/Text (str "By: " author)
                                 .style (m/TextStyle .color m/Colors.grey)))]))))))
(defn events-body []
  (m/StreamBuilder
   .stream (-> (fs/FirebaseFirestore.instance)
               (.collection "github_events")
               (.orderBy "timestamp" .descending true)
               (.snapshots))
   .builder (fn [_ctx snapshot]
              (cond
                (.-hasError snapshot)
                (m/Center
                 .child (m/Text (str "Error: " (.-error snapshot))))

                (not (.-hasData snapshot))
                (m/Center .child (m/CircularProgressIndicator))

                :else
                (let [docs (.-docs (.-data snapshot))]
                  (if (empty? docs)
                    (m/Center .child (m/Text "No events yet"))
                    (m/ListView.builder
                     .padding (m/EdgeInsets.symmetric .vertical 8.0)
                     .itemCount (count docs)
                     .itemBuilder (fn [_ i] (event-card (nth docs i))))))))))

(defn ^:async main []
  (m/WidgetsFlutterBinding.ensureInitialized)
  (await (fb/Firebase.initializeApp .options firebase-options))
  ;; Only route traffic to the local emulator in debug builds.
  ;; Release builds connect to the real Firebase project.
  (when foundation/kDebugMode
    (.useFirestoreEmulator (fs/FirebaseFirestore.instance) emulator-host emulator-port))
  (f/run
    (m/MaterialApp
     .title "Pokeapr"
     .theme (m/ThemeData .primarySwatch m/Colors.blue)
     .home (m/Scaffold
            .appBar (m/AppBar .title (m/Text "GitHub Events"))
            .body (events-body)))))
